# ---- App (port 3000) ----
PORT=3100
PUBLIC_BASE_URL=http://localhost:3100
# Bearer key required on /api/* (generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
API_KEY=c4e78bbc5972e948addc843fe0451e2870cfc0067ff0fff8
# AES-256-GCM key for OAuth tokens at rest: 32 random bytes, base64
# (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
TOKEN_ENCRYPTION_KEY=af294eCiTCG7JTDjBkIQuCc5h2dthiKsU06uVhx29mg=
DATA_DIR=./data
BRAND_NAME=Social Media Studio

# ---- Worker ----
WORKER_IN_PROCESS=true
WORKER_POLL_MS=1000
WORKER_LEASE_MS=30000
WORKER_BATCH_SIZE=10
MAX_ATTEMPTS=8
# Enables /api/admin/* (virtual clock, manual tick). Turn off in production.
ENABLE_DEMO_CONTROLS=true

# ---- Fake platform (port 4010) ----
PLATFORM_BASE_URL=http://localhost:4010
PLATFORM_PORT=4010
PLATFORM_TIMEOUT_MS=3000
PLATFORM_CLIENT_ID=studio-app
PLATFORM_CLIENT_SECRET=1cdf428d1a249b43ace7d71b9eb38189
# Shared HMAC secret used to sign delivery webhooks
WEBHOOK_SECRET=16f4f1677af9b21ca316d57495e0614585a516ebf4691f50
WEBHOOK_URL=http://localhost:3100/webhook/social-delivery
